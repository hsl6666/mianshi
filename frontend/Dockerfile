ARG NODE_IMAGE=node:20-alpine
ARG NGINX_IMAGE=nginx:1.27-alpine
FROM ${NODE_IMAGE} AS build

WORKDIR /app
ARG VITE_API_BASE_URL
ARG VITE_WANGJUN_LOGIN_ENABLED
ARG VITE_WANGJUN_API_BASE_URL
ARG VITE_WANGJUN_PROXY_TARGET
ARG NPM_CONFIG_REGISTRY
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL:-}
ENV VITE_WANGJUN_LOGIN_ENABLED=${VITE_WANGJUN_LOGIN_ENABLED:-false}
ENV VITE_WANGJUN_API_BASE_URL=${VITE_WANGJUN_API_BASE_URL:-/wangjun}
ENV VITE_WANGJUN_PROXY_TARGET=${VITE_WANGJUN_PROXY_TARGET:-http://101.42.182.149}
COPY package*.json ./
RUN if [ -n "$NPM_CONFIG_REGISTRY" ]; then npm config set registry "$NPM_CONFIG_REGISTRY"; fi \
    && npm ci
COPY . .
RUN npm run build

FROM ${NGINX_IMAGE}
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
