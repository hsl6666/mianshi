# Copy this file to scripts/deploy/deploy.env and fill in your server values.
# Do not commit deploy.env.

APP_NAME=mianshi

# SSH target.
SERVER_HOST=your.server.ip
SERVER_USER=root
SERVER_PORT=22
SERVER_SSH_KEY=

# Uploads go here first. A relative path is relative to the SSH user's home.
REMOTE_UPLOAD_DIR=mianshi-deploy

# Runtime paths on the server.
REMOTE_APP_DIR=/opt/mianshi
REMOTE_FRONTEND_WEB_ROOT=/var/www/mianshi
REMOTE_USE_SUDO=1
DOCKER_USE_SUDO=0
RELOAD_NGINX=1
NGINX_BIN=nginx

# Backend container.
BACKEND_IMAGE=mianshi-backend
CONTAINER_NAME=mianshi-backend
BACKEND_BIND_HOST=127.0.0.1
BACKEND_HOST_PORT=8000
BACKEND_CONTAINER_PORT=8000
BACKEND_ENV_REMOTE_FILE=/opt/mianshi/backend.env

# Optional: set this to scripts/deploy/backend.env after filling it locally.
# If empty, the script keeps the server's existing backend env file.
BACKEND_ENV_LOCAL_FILE=

# Public URLs used by backend and frontend build.
# If nginx proxies /api, /uploads, /snapshots and /m to the backend, use the same site origin.
PUBLIC_BASE_URL=https://example.com
FRONTEND_ORIGIN=https://example.com
VITE_API_BASE_URL=https://example.com
VITE_PUBLIC_BASE_URL=https://example.com

# Frontend build values.
VITE_WIFI_SSID="Interview WiFi"
VITE_WIFI_PASSWORD="Ask front desk"
VITE_WRITTEN_EXAM_SECONDS=1800
VITE_ORAL_INTERVIEW_SECONDS=1800
VITE_SNAPSHOT_COUNT=4
FRONTEND_NPM_CI=0

# Backup and rollback.
BACKUP_FULL_DATA=1
ROLLBACK_ON_FAILURE=1

# One-time data migration. Keep this off for normal upgrades unless you really
# want to overwrite server data with local backend/data.
MIGRATE_LOCAL_DATA=0
LOCAL_DATA_DIR=backend/data
